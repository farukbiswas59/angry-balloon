# Local client talks to the persistent Node server.
NEXT_PUBLIC_GAME_SERVER_URL=http://localhost:3001
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development
# Production: NEXT_PUBLIC_GAME_SERVER_URL=https://YOUR-NORTHFLANK-PUBLIC-HOST
# Production: ALLOWED_ORIGINS=https://YOUR-FRONTEND-ORIGIN
# Capacitor Android: add exact https://localhost to production ALLOWED_ORIGINS.
# Behind the Northflank/Render HTTP proxy, set TRUST_PROXY=1.
TRUST_PROXY=0
